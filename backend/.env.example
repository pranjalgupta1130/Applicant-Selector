# BoardRoom AI - Backend Environment Configuration Example
# Copy this file to .env before starting the backend server

# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/boardroom_ai

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# CORS Allowed Origin (Optional for local development)
CORS_ORIGIN=http://localhost:5173
